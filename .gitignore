# Root-level ignores
.DS_Store
target/
*.failed
*_failed
run.sh

# Webui build output
webui/.next/
webui/node_modules/
webui/.env.local
webui/.env.production

# Mail server runtime files (credentials / build artifacts)
mail/config.json
mail/webui-flux.zip
mail/target/
mail/*.zip
console-app/.env.production.secrets

# Local-only credentials staged here before a deploy (e.g. the Firebase Admin
# SDK service account key for webui's mobile push relay). Never committed —
# see infra/scripts/deploy-apps.sh's FIREBASE_SERVICE_ACCOUNT_FILE.
/secrets/
