# Copy this file to .env on the worker server and fill in real values

# PostgreSQL connection string (private VPC endpoint recommended)
MIGRATION_PG_URL=postgresql://user:password@host:25060/defaultdb?sslmode=require

# Redis / Valkey connection string
REDIS_URL=rediss://default:password@host:25061

# Stalwart mail server admin API (internal IP or localhost)
STALWART_URL=http://10.x.x.x:18080
STALWART_ADMIN_USER=admin@yourdomain.com
STALWART_ADMIN_PASS=your_stalwart_admin_password

# Must match SESSION_SECRET in the Next.js webui .env
SESSION_SECRET=your_session_secret_here

# DigitalOcean Spaces (optional — for storing migration archives)
SPACES_KEY=your_do_spaces_key
SPACES_SECRET=your_do_spaces_secret
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_BUCKET=your-bucket-name

# ── Tuning (all optional; defaults shown) ─────────────────────────────────────

# Messages per message-import batch enqueued by the IMAP fan-out
IMAP_BATCH_SIZE=50

# TTL for cached Flux account/domain/mailbox IDs, in ms. Lower = pick up
# deleted/recreated accounts faster, higher = fewer JMAP round-trips.
FLUX_CACHE_TTL_MS=300000

# Stuck-user reaper (runs inside the user-migration worker)
REAPER_INTERVAL_MS=300000      # how often to sweep
REAPER_STUCK_AFTER_MS=1800000  # 'creating'/'migrating' for this long = stuck
REAPER_MAX_RETRIES=3           # re-enqueues before the user is failed
REAPER_BATCH_SIZE=100          # rows claimed per sweep

# NOTE: TLS verification against source mail servers is always on. To allow a
# broken legacy server, set migration_jobs.allow_insecure_tls = TRUE for that
# one job — there is deliberately no global switch.

# Node environment
NODE_ENV=production
